<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox id="root" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="stan.qodat.scene.controller.TimeLineController">
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
    <HBox fx:id="timeLineBox">
        <children>
            <ListView id="frame-list" fx:id="frameList" orientation="HORIZONTAL" prefHeight="50.0">
                <cursor>
                    <Cursor fx:constant="CROSSHAIR"/>
                </cursor>
            </ListView>
            <ListView fx:id="transformsList" prefHeight="100.0"/>
        </children>
    </HBox>
</VBox>
