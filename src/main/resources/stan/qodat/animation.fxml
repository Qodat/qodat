<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="viewer-box" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="stan.qodat.scene.controller.AnimationController"
      stylesheets="@style.css">
    <children>
        <ListView styleClass="animations-list" fx:id="animationsListView"/>
        <HBox alignment="CENTER_LEFT" spacing="4.0">
            <children>
                <TextField fx:id="searchTextField" maxHeight="27.0" promptText="Search animation" HBox.hgrow="ALWAYS"/>
                <Button fx:id="newPoseButton" mnemonicParsing="false" styleClass="add-button" text="+">
                    <tooltip>
                        <Tooltip text="New pose animation"/>
                    </tooltip>
                </Button>
            </children>
        </HBox>
    </children>
</VBox>
